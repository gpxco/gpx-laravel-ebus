{
  "name": "gpxco/gpx-laravel-ebus",
  "version": "1.5.0-rc.1",
  "description": "GPX Event BUS",
  "keywords": [
    "ebus"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "danikdantist/queue-wrapper": "^2.0",
    "illuminate/support": "^12.8|^13.0"
  },
  "autoload": {
    "psr-4": {
      "GPX\\EventBus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "GPX\\EventBus\\EventBusServiceProvider"
      ],
      "aliases": {
        "Broadcaster": "GPX\\EventBus\\Facades\\Broadcaster"
      }
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.3",
    "mockery/mockery": "^1.6"
  },
  "scripts": {
    "test": "phpunit"
  }
}
